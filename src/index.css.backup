@import "tailwindcss";

@custom-variant dark (&:where(.dark, .dark *));

@theme {
  /* ═══════════════════════════════════════════════════════════════════════
     ZAANISUNG DESIGN SYSTEM v2.0 — Mist / Vapor / Perfume-Inspired
     ═══════════════════════════════════════════════════════════════════════
     
     Visual Language: Soft, atmospheric, fluid, premium
     Core Metaphor: Perfume mist dispersing through air
     Aesthetic: Glassmorphism + subtle gradients + gentle depth
     
  ════════════════════════════════════════════════════════════════════════ */

  /* ─── BRAND PALETTE ─────────────────────────────────────────────────── */
  /* Gold: The signature luxury accent — softer, more diffused */
  --color-gold: #d4af37;
  --color-gold-100: #f9f3e3;
  --color-gold-200: #f5eccf;
  --color-gold-300: #e9d483;
  --color-gold-400: #dfc15a;
  --color-gold-500: #d4af37;
  --color-gold-600: #c29e2e;
  --color-gold-700: #a4881f;
  --color-gold-800: #876e18;
  --color-gold-900: #6b5a14;

  /* Ink: Deep blacks for contrast */
  --color-ink: #0a0a0a;
  --color-ink-950: #050505;
  --color-ink-900: #101010;
  --color-ink-800: #171717;
  --color-ink-700: #1f1f1f;

  /* Cream: Warm light backgrounds */
  --color-cream: #f3efe6;
  --color-cream-50: #fcfaf5;
  --color-cream-100: #fdfcf9;
  --color-cream-200: #f8f5ee;

  /* Mist: Atmospheric grays for subtle elements */
  --color-mist-50: rgba(128, 128, 128, 0.05);
  --color-mist-100: rgba(128, 128, 128, 0.1);
  --color-mist-200: rgba(128, 128, 128, 0.2);
  --color-mist-300: rgba(128, 128, 128, 0.3);

  /* ─── TYPOGRAPHY ───────────────────────────────────────────────────── */
  /* Segoe UI keeps the whole UI on one clean, non-italic system-styled font */
  --font-sans: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
  --font-brand-serif: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;
  --font-display: "Segoe UI", system-ui, -apple-system, "Helvetica Neue", Arial, sans-serif;

  /* ─── BORDER RADIUS (Soft, Rounded) ────────────────────────────────── */
  --radius-sm: 8px;
  --radius-md: 12px;
  --radius-lg: 16px;
  --radius-xl: 24px;
  --radius-2xl: 32px;
  --radius-full: 9999px;

  /* ─── SHADOWS (Soft, Atmospheric) ──────────────────────────────────── */
  /* Subtle lift — barely there, like vapor */
  --shadow-mist: 0 2px 12px -2px rgba(0, 0, 0, 0.06), 0 1px 3px -1px rgba(0, 0, 0, 0.04);
  
  /* Gentle elevation */
  --shadow-soft: 0 4px 24px -4px rgba(0, 0, 0, 0.08), 0 2px 6px -2px rgba(0, 0, 0, 0.05);
  
  /* Moderate depth */
  --shadow-lift: 0 8px 32px -8px rgba(0, 0, 0, 0.12), 0 4px 12px -4px rgba(0, 0, 0, 0.08);
  
  /* Strong presence */
  --shadow-float: 0 16px 48px -12px rgba(0, 0, 0, 0.18), 0 8px 20px -8px rgba(0, 0, 0, 0.12);
  
  /* Gold glow — diffused, not aggressive */
  --shadow-gold-glow: 0 0 0 1px rgba(212, 175, 55, 0.15), 0 8px 32px -8px rgba(212, 175, 55, 0.25), 0 4px 16px -4px rgba(212, 175, 55, 0.2);
  
  /* Soft gold shimmer for hover states */
  --shadow-gold-shimmer: 0 0 0 1px rgba(212, 175, 55, 0.2), 0 12px 40px -10px rgba(212, 175, 55, 0.35), 0 6px 20px -6px rgba(212, 175, 55, 0.25);
  
  /* Inner glow for glassmorphic surfaces */
  --shadow-glass-inset: inset 0 1px 0 rgba(255, 255, 255, 0.4), inset 0 -1px 0 rgba(0, 0, 0, 0.05);

  /* Hairline bottom inset for sticky headers */
  --shadow-hairline-inset: inset 0 -1px 0 rgba(255, 255, 255, 0.08), 0 1px 0 rgba(10, 10, 10, 0.04);

  /* Elevated modal / overlay surface */
  --shadow-lift-lg: 0 24px 64px -16px rgba(0, 0, 0, 0.22), 0 8px 20px -8px rgba(0, 0, 0, 0.14);

  /* ─── BLUR AMOUNTS ─────────────────────────────────────────────────── */
  --blur-light: 12px;
  --blur-medium: 18px;
  --blur-strong: 24px;
  --blur-heavy: 32px;

  /* ─── ANIMATION TIMINGS ────────────────────────────────────────────── */
  --duration-instant: 0ms;
  --duration-fast: 200ms;
  --duration-normal: 400ms;
  --duration-slow: 600ms;
  --duration-very-slow: 800ms;

  /* ─── ANIMATION EASINGS ────────────────────────────────────────────── */
  --ease-out: cubic-bezier(0.4, 0, 0.2, 1);
  --ease-in-out: cubic-bezier(0.4, 0, 0.6, 1);
  --ease-in: cubic-bezier(0.4, 0, 1, 1);
  --ease-spring: cubic-bezier(0.68, -0.55, 0.265, 1.55);
  --ease-mist: cubic-bezier(0.25, 0.46, 0.45, 0.94); /* Soft, vapor-like */

  /* ─── MOTION TOKENS ────────────────────────────────────────────────── */
  /* Slow drifting vapor for ambient orbs */
  --animate-mist-drift: mist-drift 10s ease-in-out infinite;
  --animate-mist-float: mist-float 12s ease-in-out infinite;
  --animate-mist-pulse: mist-pulse 7s ease-in-out infinite;

  /* Micro-entrances for overlays, modals, popovers & dropdowns */
  --animate-fade-in: fade-in 0.3s ease-out both;
  --animate-zoom-in: zoom-in 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  --animate-slide-up: slide-up 0.34s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;
  --animate-slide-down: slide-down 0.28s cubic-bezier(0.25, 0.46, 0.45, 0.94) both;

  /* Gentle sheen that travels along kente accents */
  --animate-kente-shimmer: kente-shimmer 9s ease-in-out infinite;
}

@layer base {
  :root {
    color-scheme: light;
  }

  :root.dark {
    color-scheme: dark;
  }

  html {
    scroll-behavior: smooth;
  }

  body {
    font-family: var(--font-sans);
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    margin: 0;
    padding: 0;
    background-color: #f6f3ec;
    background-image: url('/dagomba-smock-pattern.svg');
    background-size: 960px auto;
    background-repeat: repeat;
    background-attachment: fixed;
    text-rendering: optimizeLegibility;
  }

  .dark body {
    background-color: #070707;
    background-image: url('/dagomba-smock-pattern.svg');
    background-size: 960px auto;
    background-repeat: repeat;
    background-attachment: fixed;
    /* Apply dark mode filter */
    /* Removed filter, using dark SVG instead */
  }

  :where(section[id]) {
    scroll-margin-top: 5rem;
  }
}

/* ─── Glassmorphic surfaces (soft rounded, translucent, atmospheric blur) ─── */
@layer components {
  /* ═══ GLASS SURFACES ═══════════════════════════════════════════════════ */
  
  /* Light glass — subtle translucency */
  .surface-glass {
    background: rgba(255, 255, 255, 0.65);
    border: 1px solid rgba(10, 10, 10, 0.06);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-glass-inset), var(--shadow-mist);
    backdrop-filter: blur(var(--blur-medium)) saturate(1.2);
    -webkit-backdrop-filter: blur(var(--blur-medium)) saturate(1.2);
  }

  .dark .surface-glass {
    background: rgba(255, 255, 255, 0.04);
    border-color: rgba(255, 255, 255, 0.1);
  }

  /* Medium glass — more presence */
  .surface-glass-strong {
    background: rgba(255, 255, 255, 0.8);
    border: 1px solid rgba(10, 10, 10, 0.08);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-glass-inset), var(--shadow-soft);
    backdrop-filter: blur(var(--blur-strong)) saturate(1.3);
    -webkit-backdrop-filter: blur(var(--blur-strong)) saturate(1.3);
  }

  .dark .surface-glass-strong {
    background: rgba(13, 13, 13, 0.65);
    border-color: rgba(255, 255, 255, 0.12);
  }

  /* Gold-tinted glass — for highlights */
  .surface-glass-tint {
    background: rgba(212, 175, 55, 0.06);
    border: 1px solid rgba(212, 175, 55, 0.18);
    border-radius: var(--radius-lg);
    backdrop-filter: blur(var(--blur-light)) saturate(1.1);
    -webkit-backdrop-filter: blur(var(--blur-light)) saturate(1.1);
  }

  .dark .surface-glass-tint {
    background: rgba(212, 175, 55, 0.08);
    border-color: rgba(212, 175, 55, 0.22);
  }

  /* Dark glass — for sidebars, headers */
  .surface-ink {
    background: rgba(10, 10, 10, 0.85);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: var(--radius-xl);
    backdrop-filter: blur(var(--blur-strong)) saturate(1.2);
    -webkit-backdrop-filter: blur(var(--blur-strong)) saturate(1.2);
  }

  /* ═══ MIST EFFECTS ═════════════════════════════════════════════════════ */
  
  /* Soft mist overlay — for atmospheric depth */
  .mist-overlay {
    position: relative;
  }

  .mist-overlay::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(
      circle at 50% 0%,
      rgba(212, 175, 55, 0.03) 0%,
      rgba(212, 175, 55, 0.01) 40%,
      transparent 70%
    );
    pointer-events: none;
    border-radius: inherit;
  }

  .dark .mist-overlay::before {
    background: radial-gradient(
      circle at 50% 0%,
      rgba(212, 175, 55, 0.05) 0%,
      rgba(212, 175, 55, 0.02) 40%,
      transparent 70%
    );
  }

  /* Vapor gradient — flowing, organic */
  .vapor-gradient {
    background: linear-gradient(
      135deg,
      rgba(212, 175, 55, 0.08) 0%,
      rgba(212, 175, 55, 0.03) 35%,
      transparent 70%
    );
  }

  .dark .vapor-gradient {
    background: linear-gradient(
      135deg,
      rgba(212, 175, 55, 0.12) 0%,
      rgba(212, 175, 55, 0.05) 35%,
      transparent 70%
    );
  }

  /* ═══ GOLD TREATMENTS ══════════════════════════════════════════════════ */

  /* Gold gradient — softer, more steps */
  .gold-gradient-text {
    background: linear-gradient(
      120deg,
      #a4881f 0%,
      #c29e2e 20%,
      #d4af37 40%,
      #e9d483 60%,
      #d4af37 80%,
      #c29e2e 100%
    );
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Gold gradient background — for buttons */
  .gold-gradient-bg {
    background: linear-gradient(
      180deg,
      #e9d483 0%,
      #d4af37 50%,
      #c29e2e 100%
    );
  }

  /* ═══ DIVIDERS ═════════════════════════════════════════════════════════ */

  /* Soft gold divider */
  .hairline-gold {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(212, 175, 55, 0.4) 20%,
      rgba(212, 175, 55, 0.6) 50%,
      rgba(212, 175, 55, 0.4) 80%,
      transparent
    );
  }

  /* Soft neutral divider */
  .hairline-black {
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(10, 10, 10, 0.1) 20%,
      rgba(10, 10, 10, 0.12) 50%,
      rgba(10, 10, 10, 0.1) 80%,
      transparent
    );
  }

  .dark .hairline-black {
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.1) 20%,
      rgba(255, 255, 255, 0.12) 50%,
      rgba(255, 255, 255, 0.1) 80%,
      transparent
    );
  }

  /* ═══ ATMOSPHERIC ORBS ═════════════════════════════════════════════════ */

  /* Ambient glow orbs for immersive backgrounds */
  .orb {
    position: absolute;
    border-radius: 9999px;
    filter: blur(80px);
    pointer-events: none;
    opacity: 0.6;
  }

  .orb-gold {
    background: radial-gradient(
      circle,
      rgba(212, 175, 55, 0.18) 0%,
      rgba(212, 175, 55, 0.08) 40%,
      rgba(212, 175, 55, 0) 70%
    );
  }

  .dark .orb-gold {
    background: radial-gradient(
      circle,
      rgba(212, 175, 55, 0.22) 0%,
      rgba(212, 175, 55, 0.12) 40%,
      rgba(212, 175, 55, 0) 70%
    );
  }

  .orb-gold-strong {
    background: radial-gradient(
      circle,
      rgba(212, 175, 55, 0.32) 0%,
      rgba(212, 175, 55, 0.16) 40%,
      rgba(212, 175, 55, 0) 70%
    );
  }

  .orb-gold-faint {
    background: radial-gradient(
      circle,
      rgba(212, 175, 55, 0.1) 0%,
      rgba(212, 175, 55, 0.05) 40%,
      rgba(212, 175, 55, 0) 65%
    );
  }

  .orb-gold-soft {
    background: radial-gradient(
      circle,
      rgba(212, 175, 55, 0.24) 0%,
      rgba(212, 175, 55, 0.1) 40%,
      rgba(212, 175, 55, 0) 70%
    );
  }

  .orb-cream {
    background: radial-gradient(
      circle,
      rgba(243, 239, 230, 0.3) 0%,
      rgba(243, 239, 230, 0.12) 40%,
      rgba(243, 239, 230, 0) 70%
    );
  }

  .dark .orb-cream {
    background: radial-gradient(
      circle,
      rgba(243, 239, 230, 0.14) 0%,
      rgba(243, 239, 230, 0.05) 45%,
      rgba(243, 239, 230, 0) 70%
    );
  }

  .orb-ink {
    background: radial-gradient(
      circle,
      rgba(10, 10, 10, 0.24) 0%,
      rgba(10, 10, 10, 0.1) 45%,
      rgba(10, 10, 10, 0) 70%
    );
  }

  .orb-mist {
    background: radial-gradient(
      circle,
      rgba(128, 128, 128, 0.12) 0%,
      rgba(128, 128, 128, 0.06) 40%,
      rgba(128, 128, 128, 0) 65%
    );
  }

  .dark .orb-mist {
    background: radial-gradient(
      circle,
      rgba(255, 255, 255, 0.08) 0%,
      rgba(255, 255, 255, 0.04) 40%,
      rgba(255, 255, 255, 0) 65%
    );
  }

  /* ═══ SUBTLE GRID TEXTURE ══════════════════════════════════════════════ */

  .lux-grid {
    background-image:
      linear-gradient(to right, rgba(10, 10, 10, 0.03) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(10, 10, 10, 0.03) 1px, transparent 1px);
    background-size: 64px 64px;
  }

  .dark .lux-grid {
    background-image:
      linear-gradient(to right, rgba(255, 255, 255, 0.02) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255, 255, 255, 0.02) 1px, transparent 1px);
  }

  .lux-grid-fade {
    mask-image: radial-gradient(120% 120% at 50% 0%, black 55%, transparent 100%);
    -webkit-mask-image: radial-gradient(120% 120% at 50% 0%, black 55%, transparent 100%);
  }

  /* ═══ GHANAIAN TEXTILE PATTERNS ══════════════════════════════════════ */
  /* Kente-inspired woven cloth: fine interlocking threads of gold, ink,
     flag red and flag green. Used sparingly as bands & accents. */
  .kente-band {
    position: relative;
    height: 8px;
    border-radius: var(--radius-full);
    background-image: repeating-linear-gradient(
      90deg,
      rgba(212, 175, 55, 0.9) 0px,
      rgba(212, 175, 55, 0.9) 8px,
      rgba(10, 10, 10, 0.82) 8px,
      rgba(10, 10, 10, 0.82) 11px,
      rgba(206, 17, 38, 0.78) 11px,
      rgba(206, 17, 38, 0.78) 16px,
      rgba(252, 209, 22, 0.9) 16px,
      rgba(252, 209, 22, 0.9) 23px,
      rgba(0, 107, 63, 0.72) 23px,
      rgba(0, 107, 63, 0.72) 27px,
      rgba(212, 175, 55, 0.9) 27px,
      rgba(212, 175, 55, 0.9) 35px
    );
    box-shadow: 0 0 0 1px rgba(212, 175, 55, 0.08);
  }

  .kente-band-thin {
    height: 4px;
    background-image: repeating-linear-gradient(
      90deg,
      rgba(212, 175, 55, 0.85) 0px,
      rgba(212, 175, 55, 0.85) 6px,
      rgba(10, 10, 10, 0.7) 6px,
      rgba(10, 10, 10, 0.7) 9px,
      rgba(206, 17, 38, 0.6) 9px,
      rgba(206, 17, 38, 0.6) 13px,
      rgba(0, 107, 63, 0.55) 13px,
      rgba(0, 107, 63, 0.55) 17px
    );
  }

  /* Vertical kente strip for panel edges */
  .kente-band-vertical {
    height: auto;
    background-image: repeating-linear-gradient(
      0deg,
      rgba(212, 175, 55, 0.9) 0px,
      rgba(212, 175, 55, 0.9) 10px,
      rgba(10, 10, 10, 0.82) 10px,
      rgba(10, 10, 10, 0.82) 13px,
      rgba(206, 17, 38, 0.78) 13px,
      rgba(206, 17, 38, 0.78) 19px,
      rgba(252, 209, 22, 0.9) 19px,
      rgba(252, 209, 22, 0.9) 27px,
      rgba(0, 107, 63, 0.72) 27px,
      rgba(0, 107, 63, 0.72) 31px
    );
    border-radius: var(--radius-full);
  }

  /* Dagomba smock weave pattern for large surfaces (heroes, sidebars, panels).
     Authentic hand-woven cloth with narrow vertical strips. */
  .weave-bg {
    position: relative;
    background-color: rgba(27, 42, 107, 0.95);
    background-image: url('/dagomba-smock-pattern.svg');
    background-size: 960px auto;
    background-repeat: repeat;
    background-position: center;
  }

  .dark .weave-bg {
    background-color: rgba(27, 42, 107, 0.85);
    filter: brightness(0.75) contrast(1.15);
  }

  /* Adinkra-influenced diamond motif — a sparse, understated grid of dots
     arranged in the classic Sankofa geometry. */
  .adinkra-motif {
    background-image:
      radial-gradient(circle at 50% 50%, rgba(212, 175, 55, 0.16) 1.5px, transparent 2.25px),
      radial-gradient(circle at 100% 0%, rgba(10, 10, 10, 0.06) 1.5px, transparent 2.25px),
      radial-gradient(circle at 0% 100%, rgba(10, 10, 10, 0.06) 1.5px, transparent 2.25px);
    background-size: 28px 28px, 28px 28px, 28px 28px;
  }

  .dark .adinkra-motif {
    background-image:
      radial-gradient(circle at 50% 50%, rgba(212, 175, 55, 0.17) 1.5px, transparent 2.25px),
      radial-gradient(circle at 100% 0%, rgba(255, 255, 255, 0.05) 1.5px, transparent 2.25px),
      radial-gradient(circle at 0% 100%, rgba(255, 255, 255, 0.05) 1.5px, transparent 2.25px);
  }

  /* Simplified glyph chip — a small diamond-in-square mark, echoes Adinkra
     seal work for icons and header accents. */
  .adinkra-seal {
    position: relative;
  }

  .adinkra-seal::before {
    content: "";
    position: absolute;
    inset: 8px;
    transform: rotate(45deg);
    background: currentColor;
    border-radius: 2px;
    opacity: 0.9;
  }

  .adinkra-seal::after {
    content: "";
    position: absolute;
    inset: -2px;
    border: 1px solid currentColor;
    transform: rotate(45deg);
    border-radius: 4px;
    opacity: 0.9;
  }

  /* Woven gold frame — subtle cloth border that hugs card radius via mask. */
  .kente-frame {
    position: relative;
  }

  .kente-frame::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    padding: 3px;
    background: repeating-linear-gradient(
      135deg,
      rgba(212, 175, 55, 0.85) 0px,
      rgba(212, 175, 55, 0.85) 5px,
      rgba(10, 10, 10, 0.55) 5px,
      rgba(10, 10, 10, 0.55) 9px,
      rgba(206, 17, 38, 0.5) 9px,
      rgba(206, 17, 38, 0.5) 13px,
      rgba(0, 107, 63, 0.45) 13px,
      rgba(0, 107, 63, 0.45) 17px
    );
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0);
    mask-composite: exclude;
    pointer-events: none;
  }

  /* Dagomba smock pattern as a subtle product card background */
  .smock-bg {
    background-image: url('/dagomba-smock-pattern.svg');
    background-size: 480px auto;
    background-repeat: repeat;
    background-position: center;
  }

  .smock-bg-light {
    background-color: #f6f3ec;
    background-image: url('/dagomba-smock-pattern.svg');
    background-size: 480px auto;
    background-repeat: repeat;
    background-position: center;
    opacity: 0.15;
  }

  .dark .smock-bg-light {
    background-color: #0a0a0a;
    opacity: 0.08;
  }

  /* ═══ UPPERCASE LABELS ═════════════════════════════════════════════════ */

  .eyebrow {
    font-family: var(--font-display);
    font-size: 0.625rem;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    font-weight: 700;
  }
}

/* Custom utilities that don't map from @theme namespaces */
@utility scrollbar-none {
  scrollbar-width: none;
  -ms-overflow-style: none;
  &::-webkit-scrollbar {
    display: none;
  }
}

@utility pb-safe {
  padding-bottom: env(safe-area-inset-bottom);
}

/* ── Scrollbars: styled pills for WebKit (Chrome/Safari/Edge) + Firefox ── */
* {
  scrollbar-width: thin;
  scrollbar-color: rgba(10, 10, 10, 0.35) transparent;
}

*::-webkit-scrollbar {
  width: 10px;
  height: 10px;
}

*::-webkit-scrollbar-track {
  background: transparent;
}

*::-webkit-scrollbar-thumb {
  background: rgba(10, 10, 10, 0.28);
  border: 2px solid transparent;
  background-clip: padding-box;
  border-radius: 9999px;
}

*::-webkit-scrollbar-thumb:hover {
  background: rgba(212, 175, 55, 0.6);
  border: 2px solid transparent;
  background-clip: padding-box;
}

*::-webkit-scrollbar-corner {
  background: transparent;
}

.dark * {
  scrollbar-color: rgba(212, 175, 55, 0.35) transparent;
}

.dark *::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.16);
  border: 2px solid transparent;
  background-clip: padding-box;
}

.dark *::-webkit-scrollbar-thumb:hover {
  background: rgba(212, 175, 55, 0.65);
  border: 2px solid transparent;
  background-clip: padding-box;
}
/* ── Loaders (text-free, mist-inspired) ──────────────────────── */
@keyframes mist-drift {
  0%, 100% {
    transform: translateY(0) scale(1);
    opacity: 0.3;
  }
  50% {
    transform: translateY(-12px) scale(1.1);
    opacity: 1;
  }
}

@keyframes mist-pulse {
  0%, 100% {
    opacity: 0.2;
    transform: scale(0.95);
  }
  50% {
    opacity: 0.8;
    transform: scale(1.05);
  }
}

@keyframes vapor-spin {
  0% {
    transform: rotate(0deg);
    opacity: 0.6;
  }
  50% {
    opacity: 1;
  }
  100% {
    transform: rotate(360deg);
    opacity: 0.6;
  }
}

@keyframes mist-float {
  0%, 100% {
    transform: translateX(0) scale(1);
    opacity: 0.4;
  }
  33% {
    transform: translateX(-8px) scale(1.05);
    opacity: 0.8;
  }
  66% {
    transform: translateX(8px) scale(0.95);
    opacity: 0.6;
  }
}

/* Circular ring (spinner) page loader — smooth vapor rotation */
@keyframes vapor-ring-spin {
  from {
    transform: rotate(0deg);
    opacity: 0.7;
  }
  50% {
    opacity: 1;
  }
  to {
    transform: rotate(360deg);
    opacity: 0.7;
  }
}

/* Gentle micro-entrances for overlays & floating elements */
@keyframes fade-in {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes zoom-in {
  from { opacity: 0; transform: scale(0.96); }
  to { opacity: 1; transform: scale(1); }
}

@keyframes slide-up {
  from { opacity: 0; transform: translateY(12px) scale(0.99); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes slide-down {
  from { opacity: 0; transform: translateY(-8px) scale(0.99); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

/* Slow sheen drifting across kente accents */
@keyframes kente-shimmer {
  0%, 100% {
    background-size: 28px 28px, 28px 28px, 100% 100%;
    opacity: 0.9;
  }
  50% {
    background-size: 28px 28px, 28px 28px, 140% 100%;
    opacity: 1;
  }
}

.loader-dot {
  animation: mist-drift 1.4s ease-in-out infinite;
}

.loader-circle {
  animation: mist-pulse 1.2s ease-in-out infinite;
}

.loader-square {
  animation: mist-float 1.6s ease-in-out infinite;
}

.loader-ring {
  animation: vapor-ring-spin 1.2s cubic-bezier(0.25, 0.46, 0.45, 0.94) infinite;
}

/* ── Skeleton shimmer ──────────────────────────────── */
@keyframes shimmer {
  0% { background-position: -200% 0; }
  100% { background-position: 200% 0; }
}
.skeleton {
  background: linear-gradient(
    90deg,
    rgba(128, 128, 128, 0.12) 25%,
    rgba(128, 128, 128, 0.24) 50%,
    rgba(128, 128, 128, 0.12) 75%
  );
  background-size: 200% 100%;
  animation: shimmer 1.4s ease-in-out infinite;
}
.dark .skeleton {
  background: linear-gradient(
    90deg,
    rgba(255, 255, 255, 0.06) 25%,
    rgba(255, 255, 255, 0.12) 50%,
    rgba(255, 255, 255, 0.06) 75%
  );
  background-size: 200% 100%;
}
