# Backend API URL (used in development via Vite proxy)
# In development, Vite proxies /api to http://localhost:5000
# In production, set this to your backend URL
VITE_API_URL=http://localhost:5000

# Demo / dummy mode switch.
# Set VITE_DEMO_MODE=true to power the whole app with in-memory dummy data so you
# can test every flow (shop, cart, checkout, orders, profile, admin/seller
# inventory) without a backend. Any value other than "true" uses the real API.
#
#   VITE_DEMO_MODE=true   — dummy data mode
#   VITE_DEMO_MODE=false  — real backend (default)
#
# In demo mode:
#   - The app boots already signed-in as the demo customer "Aisha Mohammed".
#   - Signing in with ANY identifier that contains "admin" (e.g. admin@demo.com)
#     grants the ADMIN / seller role so the seller dashboard can be tested.
#   - Payments (Paystack) resolve instantly as successful.
VITE_DEMO_MODE=true