# Backend API URL.
#
# Development: Vite proxies /api to http://localhost:5000 (see vite.config.ts),
# so VITE_API_URL here is only used when resolving relative media paths such as
# /uploads/... returned by the backend.
#
# Production single-origin: leave VITE_API_URL empty and serve the frontend and
# backend behind the same domain via a reverse proxy on /api and /uploads.
#
# Production separate origins: set VITE_API_URL to the backend origin,
# e.g. https://api.zaanisung.com, and VITE_API_BASE_URL to the full API root
# (defaults to "/api").
VITE_API_URL=http://localhost:5000

# Full API base path used by all requests (defaults to "/api").
# VITE_API_BASE_URL=/api

# ─── Brand social profiles ────────────────────────────────────────────
# Real business-owned handles shown in the footer's social links. Leave blank
# to fall back to the platform roots (https://instagram.com etc.).
VITE_SOCIAL_INSTAGRAM=
VITE_SOCIAL_FACEBOOK=
VITE_SOCIAL_X=